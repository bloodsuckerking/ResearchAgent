# Local SQLite database file
DATABASE_PATH=./data/research-agent.sqlite

# owner requires login; use none only for trusted local deployments.
AUTH_MODE=owner

# Required encryption key for saved LLM API keys.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
# Set true when the app is served over HTTPS. Keep false for local HTTP only.
SESSION_COOKIE_SECURE=false

# Product metadata
NEXT_PUBLIC_APP_TITLE=AI Research Agent
NEXT_PUBLIC_APP_DESCRIPTION=Research complex questions and read source-grounded reports.
SITE_URL=

# Search: use a self-hosted SearXNG instance, or leave provider as bing.
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
# SEARCH_PROVIDER=bing

# Initial administrator only. Used by `bun run admin:create`.
# Remove ADMIN_PASSWORD after creating the administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace_with_a_long_password

# Docker Compose host port
APP_PORT=3000
